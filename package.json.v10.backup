{
  "name": "susanoo-nest",
  "version": "0.1.0",
  "description": "NestJS starter for Susanoo microservices",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-e2e.json --runInBand",
    "test:integration:watch": "jest --config ./test/jest-e2e.json --watch --runInBand",
    "test:integration:cov": "jest --config ./test/jest-e2e.json --coverage --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:run": "ts-node -r tsconfig-paths/register src/database/scripts/run-migrations.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register src/database/scripts/revert-migrations.ts",
    "db:seed:countries": "ts-node -r tsconfig-paths/register src/database/scripts/seed-countries.ts",
    "db:seed:users": "ts-node -r tsconfig-paths/register src/database/scripts/seed-users.ts",
    "db:seed:acl": "ts-node -r tsconfig-paths/register src/acl/seeders/seed-acl.ts",
    "logs:rotate": "bash scripts/rotate-logs.sh",
    "logs:cleanup": "bash scripts/cleanup-logs.sh",
    "logs:view": "tail -f logs/server.log",
    "logs:view:errors": "tail -f logs/error.log"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.916.0",
    "@casl/ability": "^6.7.3",
    "@keyv/redis": "^3.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^7.1.4",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.0",
    "@nestjs/typeorm": "^10.0.0",
    "@types/cache-manager": "^4.0.6",
    "@types/mime-types": "^3.0.1",
    "bcrypt": "^5.1.1",
    "cache-manager": "^7.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "ioredis": "^5.8.2",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.1",
    "nestjs-pino": "^4.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.4",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cache-manager": "^4.0.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.11.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "ioredis-mock": "^8.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
