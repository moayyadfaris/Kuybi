# =============================================================================
# Kuybi NestJS - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# Never commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=kuybi-api
APP_HOST=0.0.0.0
APP_PORT=4040
# Public site that emailed links point at (verify email, reset password, sign in);
# required outside development and test
APP_PUBLIC_URL=http://localhost:4040

# Application mode: api | worker
APP_MODE=api

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kuybi
# TLS to Postgres. Outside development/test a remote DB_HOST must set DB_SSL (true, or
# false on a private network); certificates are always verified there. For a private CA
# (e.g. the RDS bundle) point DB_SSL_CA_FILE at its PEM file.
# DB_SSL=true
# DB_SSL_CA_FILE=/etc/ssl/rds-global-bundle.pem
# Session limits in ms (0 disables): app statements, idle open transactions, and how
# long a migration waits for a lock
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# DB_MIGRATION_LOCK_TIMEOUT_MS=10000
TYPEORM_LOGGING=false

# Connection Pooling (auto-enabled in production)
DB_POOL_ENABLED=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Cache Redis (DB 0)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
# Prefix of every cache key (the Redis server may be shared with other apps)
CACHE_NAMESPACE=kuybi

# Queue Redis (DB 1) - separate database for BullMQ queues
REDIS_QUEUE_DB=1

# Redis Connection Pooling (auto-enabled in production)

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT signing secret - REQUIRED. In production the app refuses to boot unless it is
# at least 32 characters and not a placeholder. Generate one with: openssl rand -base64 48
# (Refresh tokens are opaque and stored hashed, so no separate refresh secret is needed.)
JWT_SECRET=change-me-kuybi-secret-key-for-production

# Token expiration times
JWT_ACCESS_EXPIRES_IN=1h
# Session and refresh-token lifetime: a number and d, h or m (30d, 12h, 90m)
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost for passwords (default 12; each +1 doubles the work). Must be at least 10
# outside development/test; existing hashes are upgraded at the next successful login.
BCRYPT_ROUNDS=12

# Password of the admin user created by `npm run db:seed:all`. Required outside
# development/test (there it defaults to Admin@123); change it after the first login.
SEED_ADMIN_PASSWORD=

# Sessions one user may hold at once; a new sign-in ends the oldest beyond it (1-100)
SESSION_MAX_PER_USER=5

# Account Lockout Configuration
# Enable/disable automatic account lockout after failed login attempts
ACCOUNT_LOCKOUT_ENABLED=true
# Maximum failed login attempts before account lockout (default: 5)
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
# Account lockout duration in milliseconds (default: 1800000 = 30 minutes)
ACCOUNT_LOCKOUT_DURATION=1800000
# Period after which failed attempts counter resets in milliseconds (default: 900000 = 15 minutes)
ACCOUNT_LOCKOUT_RESET_PERIOD=900000
# Track failed attempts by IP address in addition to user ID
# Send email notification when account is locked
ACCOUNT_LOCKOUT_NOTIFY_LOCK=true
# Send email notification when account is unlocked
ACCOUNT_LOCKOUT_NOTIFY_UNLOCK=true

# Password Security
# Minimum hours between password changes (0 = disabled, 1 = default)
PASSWORD_CHANGE_COOLDOWN_HOURS=1

# Attachments
# Process multipart image uploads in the worker by default (a request can still send async)
ATTACHMENT_ASYNC_PROCESSING=false
# Megabytes of multipart uploads one API process holds in memory at once (more: 503,
# retry); at least one maximum-size upload (110)
ATTACHMENT_MAX_IN_FLIGHT_MB=300

# Story versions
# Automatic versions kept per story and branch; the daily prune deletes older ones
# (manual, branch, merge, rollback, tagged and pinned versions are always kept)
STORY_KEEP_AUTO_VERSIONS=50
# Check passwords against HaveIBeenPwned breach database
ENABLE_BREACH_DETECTION=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_ENABLE_CONSOLE=true
LOG_PRETTY_PRINT=true
LOG_DIR=./logs
LOG_ARCHIVE_DIR=./logs/archive

# Requests slower than this (ms) are logged as warnings; 0 turns it off
# LOG_SLOW_REQUEST_MS=1000
# Request payload fields that may appear in logs (comma-separated; default: a safe
# built-in list), and the longest logged value (characters)
# LOG_SAFE_FIELDS=
# LOG_PAYLOAD_FIELD_LIMIT=160
# How often (minutes) the active log files are checked for rotation
# LOG_ROTATE_CHECK_INTERVAL=15
# Ship rotated archives to a remote sink (POST, Bearer LOG_SHIPPER_API_KEY)
# LOG_SHIPPER_ENABLED=false
# LOG_SHIPPER_ENDPOINT=
# LOG_SHIPPER_API_KEY=
# LOG_SHIPPER_FLUSH_ON_ROTATE=true

# Audit Logging
AUDIT_ENABLED=true
# Days audit rows are kept (a daily job deletes older ones); 0 keeps them forever
AUDIT_RETENTION_DAYS=180
# Days critical audit rows are kept (never less than AUDIT_RETENTION_DAYS)
AUDIT_CRITICAL_RETENTION_DAYS=365

# Log rotation
LOG_ROTATION_ENABLED=true
LOG_ROTATE_MAX_BYTES=10485760
LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# AWS S3 Configuration
# -----------------------------------------------------------------------------
S3_BUCKET=kuybi-dev-attachments
S3_REGION=us-east-1
S3_UPLOAD_PREFIX=uploads
# Static keys (both or neither). Leave both unset to use the AWS default credential chain
# (environment, shared profile, or the IAM role of the instance / ECS task / pod).
# S3_SESSION_TOKEN is only for temporary credentials.
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_SESSION_TOKEN=
S3_BASE_URL=https://kuybi-dev-attachments.s3.amazonaws.com

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:4040

# Swagger UI at /api/docs (default: enabled outside production, disabled in production)
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# Response Compression
# -----------------------------------------------------------------------------
# Enable/disable gzip compression for responses
COMPRESSION_ENABLED=true
# Minimum response size in bytes to compress (1KB = 1024 bytes)
COMPRESSION_THRESHOLD=1024
# Compression level (0-9): 0=no compression, 9=best compression, 6=balanced
COMPRESSION_LEVEL=6

# -----------------------------------------------------------------------------
# Proxies and timeouts
# -----------------------------------------------------------------------------
# Proxies in front of the app whose X-Forwarded-For is trusted: unset/false = none,
# a hop count ("1"), or addresses/subnets ("loopback, 10.0.0.0/8"). Needed behind a
# load balancer, or every client shares its IP (rate limits, sessions, audit).
# TRUST_PROXY=1
# Calls to Redis (cache), S3 and SMTP: time limit per call, and the circuit breaker
# (failures in a row that open it, ms before trying again)
# CACHE_TIMEOUT_MS=1500
# CACHE_CIRCUIT_BREAKER_FAILURES=10
# CACHE_CIRCUIT_BREAKER_RESET_MS=20000
# S3_TIMEOUT_MS=10000
# S3_CIRCUIT_BREAKER_FAILURES=5
# S3_CIRCUIT_BREAKER_RESET_MS=30000
# SMTP_TIMEOUT_MS=15000
# SMTP_CIRCUIT_BREAKER_FAILURES=5
# SMTP_CIRCUIT_BREAKER_RESET_MS=30000
# Time the worker lets active jobs finish on shutdown
# WORKER_SHUTDOWN_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Bull Board Dashboard
# -----------------------------------------------------------------------------
BULL_BOARD_PORT=4050
# Loopback by default; 0.0.0.0 only behind an authenticating TLS proxy
# BULL_BOARD_HOST=127.0.0.1
BULL_BOARD_USERNAME=admin
# REQUIRED - the dashboard will not start without it
BULL_BOARD_PASSWORD=change-me-secure-password

# -----------------------------------------------------------------------------
# Email Service
# -----------------------------------------------------------------------------
# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# STARTTLS is required on plain ports and certificates are verified. Only a local mail
# catcher (Mailpit, MailHog) may turn these off; deployed environments refuse "false".
# SMTP_REQUIRE_TLS=true
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Email addresses
EMAIL_FROM=Kuybi <noreply@kuybi.dev>
EMAIL_SUPPORT=support@kuybi.dev
# Contact for security questions, shown in account-locked emails
EMAIL_SECURITY=security@kuybi.dev

# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# For other providers: Update SMTP_HOST, SMTP_PORT, and credentials

# -----------------------------------------------------------------------------
# Sentry Error Tracking & Monitoring
# -----------------------------------------------------------------------------
# Enable/disable Sentry (auto: true in production, false in dev)
SENTRY_ENABLED=false

# Sentry DSN from your Sentry project
# Get this from: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_DSN=

# Environment name (development, staging, production)
SENTRY_ENVIRONMENT=development

# Release version for tracking deployments
# Format: app-name@version or git-commit-sha
SENTRY_RELEASE=kuybi-nest@0.1.0

# Sample rate for performance traces (0-100)
# 10 = 10% of requests tracked, 100 = all requests
# Production recommended: 10, Staging: 50, Dev: 0
SENTRY_TRACES_SAMPLE_RATE=10

# Sample rate for profiling (0-100)
# Should be lower than traces sample rate
SENTRY_PROFILES_SAMPLE_RATE=10

# Enable debug mode for Sentry SDK (verbose logging)
SENTRY_DEBUG=false

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry & Prometheus)
# -----------------------------------------------------------------------------
# Enable/disable OpenTelemetry tracing
OBSERVABILITY_TRACING_ENABLED=true

# Jaeger Host & Port (for OTLP export)
OBSERVABILITY_JAEGER_HOST=localhost
OBSERVABILITY_JAEGER_PORT=4318
# Service name and version reported with traces
# OTEL_SERVICE_NAME=kuybi-backend
# APP_VERSION=
