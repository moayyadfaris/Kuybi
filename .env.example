# =============================================================================
# Susanoo NestJS - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# Never commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=susanoo-api
APP_HOST=0.0.0.0
APP_PORT=4040

# Application mode: api | worker
APP_MODE=api

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=susanoo
TYPEORM_LOGGING=false

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Cache Redis (DB 0)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Queue Redis (DB 1) - separate database for BullMQ queues
REDIS_QUEUE_DB=1

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT Secret Keys (CHANGE IN PRODUCTION!)
JWT_SECRET=change-me-susanoo-secret-key-for-production
JWT_REFRESH_SECRET=change-me-susanoo-refresh-secret-key-for-production

# Token expiration times
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Session configuration
SESSION_MAX_PER_USER=5
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=60

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_ENABLE_CONSOLE=true
LOG_PRETTY_PRINT=true
LOG_DIR=./logs
LOG_ARCHIVE_DIR=./logs/archive

# Audit Logging
AUDIT_ENABLED=true

# Log rotation
LOG_ROTATION_ENABLED=true
LOG_ROTATE_MAX_BYTES=10485760
LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# AWS S3 Configuration
# -----------------------------------------------------------------------------
S3_BUCKET=susanoo-dev-attachments
S3_REGION=us-east-1
S3_UPLOAD_PREFIX=uploads
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BASE_URL=https://susanoo-dev-attachments.s3.amazonaws.com

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Bull Board Dashboard
# -----------------------------------------------------------------------------
BULL_BOARD_PORT=4050
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change-me-secure-password

# -----------------------------------------------------------------------------
# Email Service
# -----------------------------------------------------------------------------
# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email addresses
EMAIL_FROM=Susanoo <noreply@susano.dev>
EMAIL_SUPPORT=support@susano.dev

# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# For other providers: Update SMTP_HOST, SMTP_PORT, and credentials

# -----------------------------------------------------------------------------
# SMS Service (Future)
# -----------------------------------------------------------------------------
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
