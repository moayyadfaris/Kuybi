{
  "name": "kuybi-nest",
  "version": "0.1.0",
  "description": "Enterprise-grade NestJS backend inspired by Naruto's Kuybi",
  "license": "Apache-2.0",
  "author": "Moayyad Faris <moayyadzf@gmail.com>",
  "homepage": "https://moayyadfaris.com/open-source/kuybi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moayyadfaris/Kuybi.git"
  },
  "bugs": {
    "url": "https://github.com/moayyadfaris/Kuybi/issues"
  },
  "private": true,
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "start:dashboard": "ts-node -r tsconfig-paths/register src/dashboard.ts",
    "start:dashboard:prod": "node dist/dashboard.js",
    "start:dashboard:dev": "nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/dashboard.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "typecheck:fields": "node scripts/check-property-init.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.unit.config.ts",
    "test:unit:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.unit.config.ts --coverage --coverageDirectory=coverage/unit",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "test:integration:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --watch --runInBand",
    "test:integration:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand --coverage --coverageDirectory=coverage/integration",
    "coverage:check": "node scripts/check-coverage.js",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:performance": "NODE_OPTIONS=--experimental-vm-modules jest test/performance/story-version-load.test.ts --runInBand --detectOpenHandles",
    "perf:diagnose": "node test/performance/diagnose-api.js",
    "perf:db": "ts-node -r tsconfig-paths/register test/performance/db-performance-check.ts",
    "perf:artillery": "artillery run test/performance/artillery-load-test.yml",
    "migration:run": "ts-node -r tsconfig-paths/register src/database/scripts/run-migrations.ts",
    "migration:run:prod": "node dist/database/scripts/run-migrations.js",
    "migration:revert": "ts-node -r tsconfig-paths/register src/database/scripts/revert-migrations.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "security:scan-uploads": "ts-node -r tsconfig-paths/register src/database/scripts/scan-risky-uploads.ts",
    "db:seed:countries": "ts-node -r tsconfig-paths/register src/modules/countries/seeders/seed-countries.ts",
    "db:seed:users": "ts-node -r tsconfig-paths/register src/modules/users/seeders/seed-users.ts",
    "db:seed:categories": "ts-node -r tsconfig-paths/register src/modules/categories/seeders/seed-categories.ts",
    "db:seed:tags": "ts-node -r tsconfig-paths/register src/modules/tags/seeders/seed-tags.ts",
    "db:seed:stories": "ts-node -r tsconfig-paths/register src/modules/stories/seeders/seed-stories.ts",
    "db:seed:all": "ts-node -r tsconfig-paths/register src/database/scripts/seed-all.ts",
    "db:seed:acl": "ts-node -r tsconfig-paths/register src/modules/acl/seeders/seed-acl.ts",
    "db:seed:acl:prod": "node dist/modules/acl/seeders/seed-acl.js",
    "db:seed:post-types": "ts-node -r tsconfig-paths/register src/modules/post-types/seeders/seed-post-types.ts",
    "logs:rotate": "bash scripts/rotate-logs.sh",
    "logs:cleanup": "bash scripts/cleanup-logs.sh",
    "logs:view": "tail -f logs/server.log",
    "logs:view:errors": "tail -f logs/error.log",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:flush": "pm2 flush",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.916.0",
    "@bull-board/api": "^6.14.0",
    "@bull-board/express": "^6.14.0",
    "@casl/ability": "^7.0.2",
    "@keyv/redis": "^5.1.3",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^12.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@types/cache-manager": "^4.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/validator": "^13.15.4",
    "@willsoto/nestjs-prometheus": "^7.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.61.2",
    "cache-manager": "^7.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-basic-auth": "^1.2.1",
    "file-type": "^21.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^2.31.0",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.14",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.17",
    "validator": "^13.15.20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cache-manager": "^4.0.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jest": "^30.5.2",
    "lint-staged": "^16.2.7",
    "pm2": "^6.0.13",
    "prettier": "^3.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@sentry/node-cpu-profiler@2.4.4": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.6": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "@scarf/scarf": false
  }
}
