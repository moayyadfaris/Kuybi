{
  "name": "kuybi-nest",
  "version": "0.1.0",
  "description": "Enterprise-grade NestJS backend inspired by Naruto's Kuybi",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "start:dashboard": "ts-node -r tsconfig-paths/register src/dashboard.ts",
    "start:dashboard:dev": "nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/dashboard.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-e2e.json --runInBand",
    "test:integration:watch": "jest --config ./test/jest-e2e.json --watch --runInBand",
    "test:integration:cov": "jest --config ./test/jest-e2e.json --coverage --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:performance": "jest test/performance/story-version-load.test.ts --runInBand --detectOpenHandles",
    "perf:diagnose": "node test/performance/diagnose-api.js",
    "perf:db": "ts-node -r tsconfig-paths/register test/performance/db-performance-check.ts",
    "perf:artillery": "artillery run test/performance/artillery-load-test.yml",
    "migration:run": "ts-node -r tsconfig-paths/register src/core/database/scripts/run-migrations.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register src/core/database/scripts/revert-migrations.ts",
    "db:seed:countries": "ts-node -r tsconfig-paths/register src/modules/countries/seeders/seed-countries.ts",
    "db:seed:users": "ts-node -r tsconfig-paths/register src/modules/users/seeders/seed-users.ts",
    "db:seed:categories": "ts-node -r tsconfig-paths/register src/modules/categories/seeders/seed-categories.ts",
    "db:seed:tags": "ts-node -r tsconfig-paths/register src/modules/tags/seeders/seed-tags.ts",
    "db:seed:stories": "ts-node -r tsconfig-paths/register src/modules/stories/seeders/seed-stories.ts",
    "db:seed:all": "ts-node -r tsconfig-paths/register src/core/database/scripts/seed-all.ts",
    "db:seed:acl": "ts-node -r tsconfig-paths/register src/modules/acl/seeders/seed-acl.ts",
    "db:seed:post-types": "ts-node -r tsconfig-paths/register src/modules/post-types/seeders/seed-post-types.ts",
    "logs:rotate": "bash scripts/rotate-logs.sh",
    "logs:cleanup": "bash scripts/cleanup-logs.sh",
    "logs:view": "tail -f logs/server.log",
    "logs:view:errors": "tail -f logs/error.log",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:flush": "pm2 flush"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.916.0",
    "@bull-board/api": "^6.14.0",
    "@bull-board/express": "^6.14.0",
    "@bull-board/nestjs": "^6.14.0",
    "@casl/ability": "^6.7.3",
    "@keyv/redis": "^5.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.7",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/node": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@types/cache-manager": "^4.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/nodemailer": "^7.0.3",
    "@types/validator": "^13.15.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.61.2",
    "cache-manager": "^7.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express-basic-auth": "^1.2.1",
    "file-type": "^21.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^2.31.0",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.1",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pino-http": "10.5.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.1.14",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.4",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.17",
    "validator": "^13.15.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cache-manager": "^4.0.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "ioredis-mock": "^8.13.0",
    "jest": "^29.7.0",
    "pm2": "^6.0.13",
    "prettier": "^3.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
