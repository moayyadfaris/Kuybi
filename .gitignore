# -----------------------------
# Node / NestJS standard ignores
# -----------------------------

# Node modules
node_modules/

# Build output
dist/
build/
tmp/
temp/

# TypeScript cache
*.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Coverage reports
coverage/
.nyc_output/

# Compiled binary addons
build/Release

# PM2 logs & dumps
pids/
pids.log
*.pid
*.pid.lock
pm2.log
dump.rdb

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini

# Test-related
jest-html-reporters-*.html
test-results.xml
test-report.xml

# Optional caches
.cache/
.eslintcache
.stylelintcache
.prettier-cache/
husky/_/

# Docker & container-related
docker-compose.override.yml
.docker/
*.local.yml

# Environment-specific configs
.env.local
.env.development.local
.env.test.local
.env.production.local

# Misc
*.tgz
*.tar.gz
*.zip

# Ignore coverage/lint/temp files from CI tools
reports/
artifacts/
