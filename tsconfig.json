{
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2017",
    // Type definitions for the Node 24 runtime; the emit target stays ES2017 (ES2022
    // would turn on useDefineForClassFields and break decorated entity/DTO fields)
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    // Every strict flag is on except strictPropertyInitialization. It is off on purpose:
    // TypeORM entities and class-validator/class-transformer DTOs are populated by the
    // framework, so it would demand a `!` on ~520 properties for no real safety. Other
    // classes must still initialize their fields: `npm run typecheck:fields` (run in CI).
    "strict": false,
    "alwaysStrict": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictBuiltinIteratorReturn": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "types": ["*"],
    "paths": {
      "@app/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"],
      "@infrastructure/*": ["./src/infrastructure/*"]
    }
  },
  // ts-node (seeders, migrations) otherwise compiles only imported files and misses
  // global augmentations such as src/shared/types/express.d.ts
  "ts-node": { "files": true },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
