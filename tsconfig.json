{
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2017",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    // Strict mode is being enabled one flag at a time (Phase 4). "strict" stays false until
    // every flag below is on; then this block collapses to "strict": true.
    "strict": false,
    "alwaysStrict": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictBuiltinIteratorReturn": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "types": ["*"],
    "paths": {
      "@app/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"],
      "@infrastructure/*": ["./src/infrastructure/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
