# Integration test environment. Copy to .env.test and point it at a throwaway database:
# the test setup DROPS and recreates its schema on every run.
#
# Tests must pass with only these variables (CI sets the same ones in
# .github/workflows/ci.yml); never make a test depend on your local .env.
NODE_ENV=test

# Test database (dropped and rebuilt from the migrations by test/setup.ts)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=kuybi_test

# Test Redis (a dedicated DB index; the tests clear it)
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_DB=15

# JWT (test only)
JWT_SECRET=test-only-secret-change-me
JWT_REFRESH_SECRET=test-only-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# S3: no test calls S3; dummy values are enough
S3_BUCKET=test-bucket
S3_REGION=us-east-1
S3_ACCESS=test-access-key
S3_SECRET=test-secret-key
